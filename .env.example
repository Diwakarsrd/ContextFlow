# Copy to .env and fill in as needed. Nothing here is required for the
# local-first defaults (`contextflow init` / `ingest` / `search`).
#
# Storage is local today: SQLite metadata + local vector/graph files in
# the workspace directory (`--path`, default ./.contextflow). Postgres,
# Qdrant/pgvector and Neo4j storage backends are on the roadmap, not yet
# implemented — see ROADMAP.md.

# --- Embeddings ---
# openai | ollama | cohere | spacy. Leave unset for the dependency-free
# hash placeholder (fine for a demo, not for real retrieval quality).
# `ollama` runs fully locally: `ollama pull nomic-embed-text`.
# Re-ingest after changing providers: vectors from different providers
# can't be mixed in one workspace (or use a separate `--path`).
CONTEXTOS_EMBEDDING_PROVIDER=
OPENAI_API_KEY=
COHERE_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Connectors ---
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
NOTION_API_KEY=

# --- API / MCP-over-HTTP auth ---
# Comma-separated key:principal pairs, e.g. "sk_abc123:alice,sk_def456:bob".
# Leave unset for local dev (open mode, no auth — see SECURITY.md).
# Prefer `contextflow auth create-key <principal>` for local key
# generation; use this for prod/CI secret injection.
CONTEXTOS_API_KEYS=
