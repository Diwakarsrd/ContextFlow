# Copy to .env and fill in as needed. Nothing here is required for
# `contextos init` (local-first / SQLite mode).

# --- Metadata store ---
CONTEXTOS_METADATA_BACKEND=sqlite          # sqlite | postgres
POSTGRES_URL=postgresql://contextos:contextos@localhost:5432/contextos

# --- Vector store ---
CONTEXTOS_VECTOR_BACKEND=local             # local | qdrant | pgvector
QDRANT_URL=http://localhost:6333

# --- Graph store (optional, v0.2+) ---
CONTEXTOS_GRAPH_BACKEND=none               # none | neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=contextos

# --- Embeddings / LLM providers ---
# CONTEXTOS_EMBEDDING_PROVIDER selects the real semantic embedding
# backend for the CLI (openai | ollama | cohere | spacy). Leave unset to
# use the dependency-free hash placeholder — fine for a demo, not for
# real retrieval quality. `spacy` needs no API key or server: pip
# install spacy && python -m spacy download en_core_web_md. See
# src/contextos/embeddings/ and benchmarks/external/locomo/RESULTS.md
# for a real measured comparison.
CONTEXTOS_EMBEDDING_PROVIDER=
OPENAI_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
# NOTE: switching CONTEXTOS_EMBEDDING_PROVIDER after you've already
# ingested data into a workspace will mix incompatible vector
# dimensions/spaces in .contextos/vectors.json. Re-run `contextos ingest`
# after changing providers, or use separate workspaces (`--path`, once
# that flag lands — see ROADMAP.md).

# --- Connectors ---
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
NOTION_API_KEY=

# --- API / MCP server ---
CONTEXTOS_API_PORT=8000
CONTEXTOS_MCP_PORT=8765
# Comma-separated key:principal pairs, e.g. "sk_abc123:alice,sk_def456:bob".
# Leave unset for local dev (open mode, no auth — see SECURITY.md).
# Prefer `contextos auth create-key <principal>` for local key generation;
# use this env var for prod/CI secret injection.
CONTEXTOS_API_KEYS=
